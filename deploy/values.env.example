# Copy to values.env (git-ignore the real one; secrets stay in Jenkins/Vault).
# These feed envsubst into deploy/manifests/*.yaml.

NS=shorebird
DOMAIN=ota.yourdomain.com
ACME_EMAIL=you@yourdomain.com

REGISTRY=ghcr.io/aldiinugroho
IMAGE=shorebird-controlplane
INGRESS_CLASS=nginx
STORAGE_CLASS=standard
IMAGE_PULL_SECRET=ghcr-pull      # a Secret with registry creds; delete if public

# secrets — Jenkins injects these (string credentials), do NOT commit real values:
API_KEY=
URL_SIGNING_SECRET=
